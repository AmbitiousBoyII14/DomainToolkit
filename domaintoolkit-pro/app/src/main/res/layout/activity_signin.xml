<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/background_light">

    <ProgressBar
        android:id="@+id/signin_progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign in to Domain Toolkit Pro"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sync your premium &amp; history across devices"
        android:textSize="14sp"
        android:textColor="@color/text_secondary_light"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Google Sign-In -->
    <Button
        android:id="@+id/btn_google_signin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Continue with Google"
        android:textColor="#FFFFFF"
        android:background="#4285F4"
        android:layout_marginBottom="12dp"
        android:textSize="15sp" />

    <!-- Facebook Sign-In -->
    <Button
        android:id="@+id/btn_facebook_signin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Continue with Facebook"
        android:textColor="#FFFFFF"
        android:background="#1877F2"
        android:layout_marginBottom="12dp"
        android:textSize="15sp" />

    <!-- Divider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/text_secondary_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  or  "
            android:textSize="12sp"
            android:textColor="@color/text_secondary_light" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/text_secondary_light" />
    </LinearLayout>

    <!-- Skip -->
    <Button
        android:id="@+id/btn_skip_signin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Continue as Guest"
        android:textColor="@color/text_secondary_light"
        android:background="@android:color/transparent"
        android:textSize="14sp" />

    <!-- Status -->
    <TextView
        android:id="@+id/signin_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="@color/text_secondary_light"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- Sign Out -->
    <Button
        android:id="@+id/btn_signout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Sign Out"
        android:textColor="#FF4444"
        android:background="@android:color/transparent"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

</LinearLayout>
